{
  "project": {
    "name": {
      "title": "pfSense Actions",
      "slug": "pfsense-actions"
    },
    "description": {
      "short": "A small authenticated controller for running focused remote actions on a pfSense firewall",
      "long": "pfSense Actions is a small self-hosted controller for safely triggering a focused set of firewall operations. It turns reviewed pfSense commands into authenticated HTTP actions for home automation and network workflows without exposing a general shell, packaged as a predictable Express service and Docker image."
    },
    "keywords": [
      "pfsense",
      "firewall",
      "wake-on-lan",
      "network-automation",
      "express",
      "typescript",
      "nodejs",
      "docker"
    ],
    "legalName": "Jacky Liang",
    "pronouns": "personal",
    "platforms": [
      "nodejs",
      "docker",
      "pfsense",
      "web"
    ],
    "startingYear": 2024,
    "license": "MIT"
  },
  "entities": [
    {
      "name": "Jacky Liang",
      "email": "hello@mrjackyliang.com",
      "url": "https://www.mrjackyliang.com/",
      "roles": [
        "author"
      ]
    }
  ],
  "emails": {
    "bugs": "bugs@mrjackyliang.com"
  },
  "github": {
    "owner": "mrjackyliang",
    "repo": "pfsense-actions",
    "topics": [
      "pfsense",
      "firewall",
      "wake-on-lan",
      "network-automation",
      "express",
      "typescript",
      "nodejs",
      "docker"
    ],
    "features": {
      "issues": true,
      "wiki": false,
      "projects": false,
      "discussions": false,
      "sponsorships": true
    },
    "policies": {
      "visibility": "public",
      "defaultBranch": "main",
      "mergeMethods": {
        "merge": true,
        "squash": true,
        "rebase": true
      },
      "mergeCommit": {
        "title": "merge-message",
        "message": "pull-request-title"
      },
      "squashMerge": {
        "title": "commit-or-pull-request-title",
        "message": "commit-messages"
      },
      "autoDeleteHeadBranch": true,
      "autoMerge": false,
      "allowUpdateBranch": false,
      "webCommitSignoffRequired": false
    },
    "security": {
      "vulnerabilityAlerts": true,
      "dependabotSecurityUpdates": false,
      "secretScanning": true,
      "pushProtection": true
    },
    "rulesets": {
      "defaultBranch": {
        "enforcement": "active",
        "blockDeletions": true,
        "blockForcePushes": true,
        "requireLinearHistory": false,
        "requireSignedCommits": true,
        "requirePullRequest": false,
        "requiredStatusChecks": [],
        "requireBranchesToBeUpToDate": false
      }
    },
    "actions": {
      "enabled": true,
      "allowedActions": "all",
      "shaPinningRequired": false,
      "defaultWorkflowPermissions": "read",
      "canApprovePullRequestReviews": false,
      "artifactRetentionDays": 7
    },
    "labels": [
      {
        "name": "bug",
        "color": "d73a4a",
        "description": "Something isn't working"
      },
      {
        "name": "documentation",
        "color": "0075ca",
        "description": "Improvements or additions to documentation"
      },
      {
        "name": "duplicate",
        "color": "cfd3d7",
        "description": "This issue or pull request already exists"
      },
      {
        "name": "enhancement",
        "color": "a2eeef",
        "description": "New feature or request"
      },
      {
        "name": "good first issue",
        "color": "7057ff",
        "description": "Good for newcomers"
      },
      {
        "name": "help wanted",
        "color": "008672",
        "description": "Extra attention is needed"
      },
      {
        "name": "invalid",
        "color": "e4e669",
        "description": "This doesn't seem right"
      },
      {
        "name": "question",
        "color": "d876e3",
        "description": "Further information is requested"
      },
      {
        "name": "wontfix",
        "color": "ffffff",
        "description": "This will not be worked on"
      }
    ],
    "issueTemplate": {
      "bugReportFields": [
        "nodejs",
        "pfsense",
        "docker"
      ]
    }
  },
  "workflows": [
    {
      "template": "check-sponsor-gated-issues",
      "name": "sponsor-check",
      "triggers": [
        "issue-comment",
        "issues"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "lock-inactive-issues",
      "name": "lock-inactive",
      "triggers": [
        "schedule-weekly"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 5
    },
    {
      "template": "publish",
      "name": "project",
      "triggers": [
        "release"
      ],
      "runsOn": "ubuntu-latest",
      "timeoutMinutes": 45,
      "build": [
        "./apps/docs"
      ],
      "deploy": [
        {
          "to": "github-pages",
          "path": "./apps/docs",
          "artifact": "documentation"
        },
        {
          "to": "docker-hub",
          "path": "./",
          "with": {
            "IMAGE_NAMESPACE": "mrjackyliang",
            "IMAGE_REPOSITORY": "pfsense-actions"
          }
        },
        {
          "to": "ghcr",
          "path": "./",
          "with": {
            "IMAGE_REPOSITORY": "pfsense-actions"
          }
        }
      ]
    }
  ],
  "urls": {
    "homepage": "https://mrjackyliang.github.io/pfsense-actions/",
    "repository": "git+https://github.com/mrjackyliang/pfsense-actions.git",
    "bugs": "https://github.com/mrjackyliang/pfsense-actions/issues",
    "license": "https://github.com/mrjackyliang/pfsense-actions/blob/HEAD/LICENSE",
    "logo": "https://mrjackyliang.github.io/pfsense-actions/images/logo.svg",
    "documentation": "https://mrjackyliang.github.io/pfsense-actions/",
    "fundSources": [
      "https://github.com/sponsors/mrjackyliang",
      "https://liang.nyc/paypal"
    ]
  },
  "readme": {
    "badges": [
      "github-release",
      "github-top-language",
      "github-license",
      "funding"
    ]
  },
  "workspaces": {
    "./": {
      "role": "project",
      "policy": "freezable",
      "name": "pfsense-actions-project"
    },
    "./apps/api": {
      "name": "pfsense-actions-app-api",
      "role": "app",
      "policy": "trackable"
    },
    "./apps/docs": {
      "name": "pfsense-actions-docs",
      "role": "docs",
      "policy": "freezable"
    },
    "./packages/docker": {
      "name": "pfsense-actions-tool-docker",
      "role": "tool",
      "policy": "freezable"
    }
  },
  "artifacts": {
    "documentation": {
      "build": [
        "./apps/docs"
      ],
      "sources": [
        {
          "from": "./apps/docs/build",
          "to": "./"
        }
      ]
    }
  },
  "ignoreFiles": {
    "./.gitignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "/assets/",
        "!package-lock.json",
        "graphify-out/",
        "api-tokens.json",
        ".data/",
        ".secrets/"
      ]
    },
    "./.dockerignore": {
      "bundles": [
        "nova"
      ],
      "patterns": [
        "assets",
        "graphify-out"
      ]
    }
  },
  "agents": [
    "claude-code",
    "codex"
  ],
  "recipes": {
    "github": {
      "sync-actions": {
        "enabled": true
      },
      "sync-features": {
        "enabled": true
      },
      "sync-identity": {
        "enabled": true
      },
      "sync-labels": {
        "enabled": true
      },
      "sync-policies": {
        "enabled": true
      },
      "sync-rulesets": {
        "enabled": true
      },
      "sync-security": {
        "enabled": true
      }
    },
    "license": {
      "update-copyright": {
        "enabled": true
      }
    },
    "miscellaneous": {
      "fix-markdown-tables": {
        "enabled": true
      },
      "remove-operating-system-files": {
        "enabled": true,
        "settings": {
          "linux": {},
          "macos": {
            "appleDouble": true,
            "desktopServicesStore": true
          },
          "windows": {
            "enhancedThumbnailDatabase": true,
            "enhancedVistaThumbnailDatabase": true,
            "thumbnailDatabase": true
          }
        }
      }
    },
    "nova-config": {
      "normalize-order": {
        "enabled": true
      }
    },
    "read-me": {
      "update-badges": {
        "enabled": true
      },
      "update-credits": {
        "enabled": true
      },
      "update-documentation": {
        "enabled": true
      },
      "update-header": {
        "enabled": true
      },
      "update-introduction": {
        "enabled": true
      }
    },
    "package-json": {
      "./": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./apps/api": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./apps/docs": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      },
      "./packages/docker": {
        "cleanup": {
          "enabled": true,
          "settings": {
            "removeUnknownKeys": true,
            "reorderKeys": true
          }
        },
        "normalize-artifacts": {
          "enabled": true
        },
        "normalize-bundler": {
          "enabled": true
        },
        "normalize-dependencies": {
          "enabled": true,
          "settings": {
            "pinDependencyVersions": true,
            "pinDevDependencyVersions": true
          }
        },
        "normalize-modules": {
          "enabled": true
        },
        "normalize-tooling": {
          "enabled": true
        },
        "sync-environment": {
          "enabled": true,
          "settings": {
            "trackNodeLtsVersions": true
          }
        },
        "sync-identity": {
          "enabled": true
        },
        "sync-ownership": {
          "enabled": true
        }
      }
    }
  },
  "environment": {
    "project": {
      "prefix": "PROJECT_"
    },
    "workspaces": {
      "./": {
        "prefix": "ROOT_",
        "variables": [
          {
            "key": "PFSENSE_ACTIONS_PORT",
            "reach": "local",
            "defaultValue": "22603"
          },
          {
            "key": "PGID",
            "reach": "local",
            "defaultValue": "1000"
          },
          {
            "key": "PUID",
            "reach": "local",
            "defaultValue": "1000"
          },
          {
            "key": "TZ",
            "reach": "local",
            "defaultValue": "UTC"
          }
        ]
      },
      "./apps/api": {
        "prefix": "PFA_",
        "variables": [
          {
            "key": "ADMIN_WEBAUTHN_RP_NAME",
            "reach": "local",
            "defaultValue": "pfSense Actions"
          },
          {
            "key": "DATA_DIRECTORY",
            "reach": "local"
          },
          {
            "key": "PORT",
            "reach": "local",
            "defaultValue": "22603"
          },
          {
            "key": "PFSENSE_SSH_IP",
            "reach": "local"
          },
          {
            "key": "PFSENSE_SSH_PORT",
            "reach": "local"
          },
          {
            "key": "PFSENSE_USERNAME",
            "reach": "local"
          },
          {
            "key": "PFSENSE_PASSWORD",
            "reach": "local"
          },
          {
            "key": "PFSENSE_PRIVATE_KEY",
            "reach": "local"
          }
        ]
      },
      "./apps/docs": {
        "prefix": "DOCS_"
      },
      "./packages/docker": {
        "prefix": "DOCKER_"
      }
    },
    "workflows": {
      "sponsor-check": {
        "prefix": "SGS_"
      }
    }
  },
  "settings": {
    "lockStepVersioning": true,
    "runWorkspaces": {
      "cache": {
        "enabled": true,
        "directory": "./node_modules/.cache/nova/run-workspaces",
        "scripts": [
          "build",
          "check"
        ]
      },
      "concurrency": {
        "build": 2,
        "check": 2,
        "deploy": 2
      }
    },
    "versionStrategy": "semver"
  }
}
