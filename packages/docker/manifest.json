{
  "build": {
    "syntheticManifests": false
  },
  "compose": {
    "environmentFiles": [],
    "name": "pfsense-actions",
    "volumes": [
      {
        "source": "pfsense_actions_data",
        "target": "/config"
      }
    ]
  },
  "healthPath": "/health",
  "images": {
    "debian": {
      "reference": "debian:trixie-20261005-slim@sha256:a29215f6a35e51e22adffa17f89e9d2ef06214e64a2bad10d765c46aea49f11f"
    },
    "node": {
      "reference": "node:24.22.0-trixie-slim@sha256:a6155384446670e9719bdc4fd0ebe4d4b29fb32a8d6aa523da3547a6cfbcf22c"
    }
  },
  "legacyStatePaths": [
    "keys/installation.key",
    "pfsense-actions.sqlite3",
    "pfsense-actions.sqlite3-shm",
    "pfsense-actions.sqlite3-wal"
  ],
  "networkMode": "host",
  "runtime": {
    "copies": [
      {
        "destination": "/app/node_modules",
        "from": "build",
        "source": "/workspace/node_modules"
      },
      {
        "destination": "/app/apps/api/package.json",
        "from": "build",
        "source": "/workspace/apps/api/package.json"
      },
      {
        "destination": "/app/apps/api/build",
        "from": "build",
        "source": "/workspace/apps/api/build"
      }
    ],
    "layout": "outputs"
  },
  "schemaVersion": 2,
  "services": [
    {
      "command": "node build/index.js",
      "critical": true,
      "dependencies": [],
      "environment": {},
      "kind": "longrun",
      "name": "pfsense-actions",
      "port": 22603,
      "requiredForHealth": true,
      "runAsRoot": false,
      "workspace": "apps/api",
      "writablePaths": []
    }
  ],
  "stateEnvironment": "DATA_DIRECTORY",
  "workspaces": [
    {
      "packageName": "pfsense-actions-app-api",
      "path": "apps/api",
      "profile": "background-service",
      "runtimePaths": []
    }
  ]
}
