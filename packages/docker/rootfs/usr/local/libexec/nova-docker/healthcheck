#!/bin/sh
set -eu
if [ -x /etc/nova-docker/healthcheck ]; then
  exec /etc/nova-docker/healthcheck
fi
/command/s6-svstat -u /run/service/pfsense-actions >/dev/null
node -e "const net = require('node:net'); const socket = net.connect(22603, '127.0.0.1'); socket.on('connect', () => { socket.end(); process.exit(0); }); socket.on('error', () => process.exit(1));"
exit 0
